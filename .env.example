# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- Tier 1: "on-premises" PostgreSQL (your laptop, or the Azure source VM) --
ONPREM_HOST=localhost
ONPREM_PORT=5432
ONPREM_DB=retail_onprem
ONPREM_USER=postgres
ONPREM_PASSWORD=
ONPREM_ADMIN_DB=postgres

# --- Tier 2: Azure Database for PostgreSQL Flexible Server (migration target)
# 01_provision_azure.ps1 prints these when it finishes.
AZPG_HOST=
AZPG_PORT=5432
AZPG_DB=retail_onprem
AZPG_USER=pgadmin
AZPG_PASSWORD=

# --- Tier 4: Databricks Lakebase Postgres endpoint --------------------------
# Compute -> Lakebase -> your project -> connection details.
LAKEBASE_HOST=
LAKEBASE_PORT=5432
LAKEBASE_DB=retail
LAKEBASE_USER=
LAKEBASE_PASSWORD=

# --- Databricks control plane ----------------------------------------------
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
UC_CATALOG=retail_demo
UC_SCHEMA=onprem
